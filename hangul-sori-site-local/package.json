{
  "name": "hangul-sori-redesign",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260811.1": true
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/clean-build.mjs",
    "build": "vinext build && node scripts/validate-artifact.mjs",
    "start": "vinext start",
    "typecheck": "tsc --noEmit --incremental false",
    "test:deployment": "node --test tests/deployment-contract.test.mjs",
    "test:unit": "node --test tests/rendered-html.test.mjs tests/deployment-contract.test.mjs tests/release-safety.test.mjs",
    "test": "npm run build && npm run test:unit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "cf": "node scripts/run-wrangler.mjs",
    "cloudflare:login": "npm run cf -- login --use-keyring",
    "deploy:dry-run": "npm run cf -- deploy --dry-run --strict --config dist/server/wrangler.json",
    "deploy:check": "npm run lint && npm run typecheck && npm test && npm run deploy:dry-run && npm run audit:security",
    "upload:built": "npm run cf -- versions upload --strict --preview-alias staging --config dist/server/wrangler.json",
    "deploy:built": "npm run cf -- deploy --strict --config dist/server/wrangler.json",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:live:external": "node scripts/verify-live.mjs --external",
    "verify:live:email": "node scripts/verify-tester-email.mjs --send",
    "deploy:production": "node scripts/deploy-production.mjs",
    "deploy:preview": "npm run deploy:check && npm run upload:built",
    "deploy": "npm run deploy:check && npm run deploy:production",
    "repair:domains": "npm run test:deployment && npm run cf -- triggers deploy --config wrangler.jsonc && npm run verify:live",
    "rollback": "npm run cf -- rollback",
    "audit:security": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@fontsource/gowun-dodum": "^5.2.6",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "pretendard": "^1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module",
  "displayName": "Hangul Sori"
}
