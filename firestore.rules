rules_version = '2';

// Hangul Sori — Firestore Security Rules
//
// Plan: docs/plans/stately-rising-jongga.md §3.3, §7.2
//
// 원칙:
//  - 모든 사용자 데이터는 `/users/{uid}/...` 하위에 격리.
//  - 본인만 read/write — 익명 / Google 링크된 anonymous 둘 다 허용.
//  - Cloud Functions 가 별도 admin SDK 로 쓰는 부분은 client rules 무시.
//  - Phase 5+ 의 Gye / Bookshelf / Custom Packs 는 별도 path 로 확장 예정.
//
// 배포:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 사용자 개인 데이터 ─────────────────────────────────────────────
    // 기존 cloud_sync.dart 가 쓰는 /users/{uid} 문서 (vok, chosung, wordle,
    // grammar, app 통계) + Phase 1 신규 sub-collections:
    //   /users/{uid}/packs/{packId}           — 팩 진행도
    //   /users/{uid}/quests/{questId}         — 특별 퀘스트 (Phase 4)
    //   /users/{uid}/bookshelf/{pageId}       — 책 한 컷 페이지 (Phase 5)
    //   /users/{uid}/custom_packs/{packId}    — 책 한 컷 커스텀 팩 (Phase 5)
    //   /users/{uid}/custom_words/{wordId}    — 책 한 컷 신규 단어 (Phase 5)
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── 번역 캐시 (Phase 5 — 책 한 컷) ────────────────────────────────
    // Cloud Function 만 write. 모든 인증된 사용자가 read 가능 (캐시 hit).
    match /cache/translations/{hash} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Function (admin SDK) 만
    }

    // ── Gye (Phase 6) — 계(契) 그룹 ───────────────────────────────────
    // gyeId == 6자리 입장 코드(bearer). 메타는 코드를 아는 인증 사용자면
    // read(가입 전 미리보기); 멤버 명단·피드·스티커는 멤버 전용.
    // memberCount/weeklyGoalProgress 정밀화 + 인원 상한은 3e Cloud Function.
    match /gye/{gyeId} {
      allow read: if request.auth != null; // 코드 보유 = bearer (미리보기)
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.code == gyeId
        && request.resource.data.memberCount == 1;
      // 계장은 전체 수정; 멤버는 memberCount 단일 필드만(가입/탈퇴 카운트).
      allow update: if isGyeOwner(gyeId)
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['memberCount'])
            && request.resource.data.memberCount is int);
      allow delete: if isGyeOwner(gyeId);

      match /members/{memberUid} {
        allow read: if isGyeMember(gyeId);
        // 가입 = 본인 멤버 문서 생성.
        allow create: if request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 20;
        allow update: if request.auth.uid == memberUid || isGyeOwner(gyeId);
        allow delete: if request.auth.uid == memberUid || isGyeOwner(gyeId);
      }

      match /feed/{eventId} {
        allow read: if isGyeMember(gyeId);
        allow create: if isGyeMember(gyeId)
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false; // Cloud Function(admin)만 정리
      }

      match /stickers/{stickerId} {
        allow read: if isGyeMember(gyeId);
        allow create: if isGyeMember(gyeId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.stickerCode is int
          && request.resource.data.stickerCode >= 1
          && request.resource.data.stickerCode <= 30;
        allow update, delete: if false;
      }

      match /reports/{reportId} {
        allow read: if isGyeOwner(gyeId);
        allow create: if isGyeMember(gyeId)
          && request.resource.data.reporterUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── 공유 단어팩 (Phase 5.2 — 친구코드) ────────────────────────────
    // 코드(문서 ID) = bearer capability. 인증 사용자는 누구나 read(=import).
    // create 는 본인(createdBy=uid)만 + wordCount 제한. update/delete 차단.
    match /shared_packs/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.wordCount is int
        && request.resource.data.wordCount <= 100;
      allow update, delete: if false;
    }

    // ── 그 외 ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ── 헬퍼 ───────────────────────────────────────────────────────────────
function isOwner(uid) {
  return request.auth != null && request.auth.uid == uid;
}

// 계 멤버 여부 — 본인 멤버 문서 존재 검사.
function isGyeMember(gyeId) {
  return request.auth != null
    && exists(/databases/(default)/documents/gye/$(gyeId)/members/$(request.auth.uid));
}

// 계장 여부 — 메타 문서 ownerId 검사 (메타 미존재 시 get() 실패 → 거부).
function isGyeOwner(gyeId) {
  return request.auth != null
    && get(/databases/(default)/documents/gye/$(gyeId)).data.ownerId == request.auth.uid;
}
