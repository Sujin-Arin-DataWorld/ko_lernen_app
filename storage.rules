rules_version = '2';

// Hangul Sori — Storage Security Rules
//
// TTS mp3: admin-confirmed learning corpus is public get-only.
// Personal/OCR synthesis is private and callable-only.
//   - 쓰기 = 차단. 사전생성 스크립트(gsutil, Jin 자격) · Cloud Function
//            admin SDK 만 기록 (admin SDK 는 client rules 를 우회).
//
// 배포:
//   firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    // Only admin-verified corpus objects may be public. Existing unclassified
    // legacy objects need approved migration; a hash filename is not privacy.
    match /tts/v3/{voice}/{fileName} {
      allow get: if voice in ['female', 'male']
        && fileName.matches('^[a-f0-9]{40}\\.mp3$')
        && 'canonical' in resource.metadata
        && resource.metadata.canonical == 'true';
      allow list: if false;
      allow write: if false;
    }

    // Personal/OCR audio is returned only by the authenticated callable, which
    // checks UID, expiry and deletion fences before reading or returning bytes.
    // This service never issues download tokens for this prefix.
    match /tts_private/{allPaths=**} {
      allow read, write: if false;
    }

    // 그 외 전부 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
