{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beyond Humanizer evaluation case",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "directions",
      "modes",
      "phenomena",
      "query",
      "expected_behavior",
      "forbidden_implications",
      "accepted_variants",
      "unresolved_fields",
      "severity_if_failed",
      "baseline_observation"
    ],
    "properties": {
      "id": {"type": "string", "minLength": 1},
      "directions": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"enum": ["ko-en", "en-ko", "ko-de", "de-ko"]}
      },
      "modes": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "translate",
            "interpret",
            "author-ko",
            "localize-triad",
            "audit-triad",
            "item-variants",
            "evidence-gate"
          ]
        }
      },
      "phenomena": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      },
      "query": {"type": "string", "minLength": 1},
      "expected_behavior": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      },
      "forbidden_implications": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      },
      "accepted_variants": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      },
      "unresolved_fields": {
        "type": "array",
        "items": {"type": "string", "minLength": 1}
      },
      "severity_if_failed": {"enum": ["critical", "major", "minor"]},
      "scene_contract": {
        "type": "object",
        "required": ["channel", "relationship", "power", "familiarity", "speech_style", "cefr", "task_type"],
        "properties": {
          "channel": {"type": "string", "minLength": 1},
          "relationship": {"type": "string", "minLength": 1},
          "power": {"type": "string", "minLength": 1},
          "familiarity": {"type": "string", "minLength": 1},
          "speech_style": {"type": "string", "minLength": 1},
          "cefr": {"type": "string", "minLength": 1},
          "task_type": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      },
      "variant_policy": {"enum": ["semantic", "construct_preserving", "surface"]},
      "evidence_expectation": {"enum": ["not_required", "risk_based_required", "human_required"]},
      "triad_invariants": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      },
      "baseline_observation": {"type": "string", "minLength": 1},
      "green_observation": {"type": "string", "minLength": 1}
    },
    "additionalProperties": true
  }
}
