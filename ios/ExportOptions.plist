<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Store 제출용 export 옵션 — macOS 담당자용.

  ⚠️ teamID 는 비워 두었다. Apple Developer 계정의 실제 Team ID(10자 영숫자,
     developer.apple.com → Membership details)를 넣어야 동작한다. 저장소에
     추측값을 박아 두면 남의 팀으로 서명 시도를 하게 되므로 일부러 비워 둔다.

  사용법은 docs/store/ios-external-setup.md 의 "Archive and export" 절 참고.
  요약: flutter build ipa 를 release 로 돌리면서 RevenueCat iOS 공개키를
  dart-define 으로 넘기고, export options 로 이 파일을 지정한다. archive 를
  직접 만들 때는 xcodebuild archive 뒤 exportArchive 에 이 파일을 넘긴다.
  (명령 원문은 XML 주석에 이중 하이픈을 못 넣어 문서 쪽에 둔다.)

  Bundle ID: com.sujinarin.koLernenApp   (ios/Runner.xcodeproj 기준)
  버전/빌드번호는 pubspec.yaml 의 version 이 FLUTTER_BUILD_NAME /
  FLUTTER_BUILD_NUMBER 로 주입된다 — Info.plist 를 직접 고치지 말 것.
-->
<plist version="1.0">
<dict>
  <!-- App Store Connect 업로드용. TestFlight 도 이 방식이다. -->
  <key>method</key>
  <string>app-store-connect</string>

  <!-- TODO(macOS 담당자): 실제 Team ID 로 교체 -->
  <key>teamID</key>
  <string></string>

  <!-- Xcode 가 프로비저닝 프로파일을 자동 관리하도록 둔다. 수동 프로파일을
       쓰려면 signingStyle 을 manual 로 바꾸고 provisioningProfiles 딕셔너리에
       번들 ID → 프로파일 이름을 넣을 것. -->
  <key>signingStyle</key>
  <string>automatic</string>

  <!-- 비트코드는 Xcode 14 부터 폐지됨. -->
  <key>uploadBitcode</key>
  <false/>

  <!-- 크래시 심볼화를 위해 dSYM 업로드. Crashlytics 도 이걸 쓴다. -->
  <key>uploadSymbols</key>
  <true/>

  <!-- App Store 배포에서는 앱 씨닝을 스토어가 처리한다. -->
  <key>stripSwiftSymbols</key>
  <true/>

  <!-- 심사 제출 전 관리자가 App Store Connect 에서 직접 눌러 올리도록 한다.
       true 로 두면 export 즉시 업로드돼 되돌리기 번거롭다. -->
  <key>destination</key>
  <string>export</string>

  <!-- 빌드 번호를 Xcode 가 임의로 자동 증가시키지 못하게 한다. 기본값(키 부재)은
       true 라 app-store-connect export 단계에서 빌드 번호가 pubspec 의
       FLUTTER_BUILD_NUMBER 보다 하나 커진 채(예: +19 → 20) 나온다. false 로
       못박아 IPA 빌드 번호를 pubspec.yaml 의 version 뒷자리와 정확히 일치시킨다. -->
  <key>manageAppVersionAndBuildNumber</key>
  <false/>
</dict>
</plist>
