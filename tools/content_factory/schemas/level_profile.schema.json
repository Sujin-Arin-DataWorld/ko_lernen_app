{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hangulsori.app/schema/level-profile-v1.json",
  "title": "LevelProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "koreanCourseLevel", "contentScope", "socialRange", "cognitiveTasks", "allowedLanguage", "portfolio"],
  "properties": {
    "code": {"enum": ["a1", "a2", "b1", "b2", "c1", "c2"]},
    "koreanCourseLevel": {"type": "integer", "minimum": 1, "maximum": 6},
    "contentScope": {"type": "string", "minLength": 1},
    "socialRange": {"type": "string", "minLength": 1},
    "cognitiveTasks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "allowedLanguage": {"type": "object"},
    "portfolio": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}}
  }
}
