    },
    {
      "voice": "male",
      "text": "물 좀 마셔도 될까요?",
      "cachePath": "tts/v3/male/153f76912bbdd7db0668d04701c1d61b3f43a1a6.mp3"
    },
    {
      "voice": "male",
      "text": "그럼요. 천천히 마셔요.",
