        "order": 2,
        "title": {
          "ko": "포용성과 지속 가능성",
          "de": "Inklusion und Nachhaltigkeit",
          "en": "Inclusion and Sustainability"
        },
        "canDo": {
          "ko": "접근성, 비용, 참여와 지역 여건의 상충 관계를 조정해 제안을 만들 수 있어요.",
          "de": "Ich kann Zielkonflikte zwischen Zugänglichkeit, Kosten, Beteiligung und lokalen Bedingungen abwägen.",
          "en": "I can balance accessibility, cost, participation, and local conditions in a practical proposal."
        },
        "prerequisiteUnitIds": [
