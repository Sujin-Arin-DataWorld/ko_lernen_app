  "curriculumExtensions": {
    "concepts": [
      {
        "id": "concept_c1_evidence_reasoning",
        "level": "c1",
        "kind": "speechStyle",
        "title": {
          "ko": "근거와 불확실성",
          "de": "Evidenz & Unsicherheit",
          "en": "Evidence & Uncertainty"
        },
        "explanation": {
          "ko": "자료의 한계와 불확실성을 밝히며 결론의 강도를 조절해요.",
          "de": "Grenzen und Unsicherheit von Daten benennen und die Stärke einer Schlussfolgerung angemessen abstufen.",
          "en": "State limitations and uncertainty while calibrating the strength of a conclusion."
        }
      },
      {
        "id": "concept_c1_inclusive_systems",
        "level": "c1",
        "kind": "situation",
        "title": {
          "ko": "포용적인 제도 설계",
          "de": "Inklusive Systemgestaltung",
          "en": "Inclusive System Design"
        },
        "explanation": {
          "ko": "당사자의 선택권, 접근성, 유지 비용을 함께 고려해 실행 가능한 제도를 제안해요.",
          "de": "Wahlmöglichkeiten, Zugänglichkeit und laufende Kosten gemeinsam berücksichtigen und umsetzbare Systeme vorschlagen.",
          "en": "Propose workable systems that account for choice, accessibility, and ongoing cost."
        }
      },
      {
        "id": "concept_c2_discourse_institutions",
        "level": "c2",
        "kind": "speechStyle",
        "title": {
          "ko": "담론과 제도 해석",
          "de": "Diskurs & Institutionen",
          "en": "Discourse & Institutions"
        },
        "explanation": {
          "ko": "표현이 책임과 권한, 기억과 해석의 틀을 어떻게 만드는지 비판적으로 분석해요.",
          "de": "Kritisch analysieren, wie Sprache Rahmen für Verantwortung, Macht, Erinnerung und Deutung schafft.",
          "en": "Critically analyze how language frames responsibility, power, memory, and interpretation."
        }
      },
      {
        "id": "concept_c2_accountable_systems",
        "level": "c2",
        "kind": "situation",
        "title": {
          "ko": "책임 있는 기술 시스템",
          "de": "Verantwortliche technische Systeme",
          "en": "Accountable Technology Systems"
        },
        "explanation": {
          "ko": "자동화된 결정의 추적 가능성, 이의 제기, 철회권과 책임 소재를 설계해요.",
          "de": "Nachvollziehbarkeit, Einspruch, Widerruf und Verantwortlichkeit automatisierter Entscheidungen gestalten.",
          "en": "Design traceability, appeals, withdrawal rights, and accountability for automated decisions."
        }
      }
    ],
    "courseUnits": [
      {
