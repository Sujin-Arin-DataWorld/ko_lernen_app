**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── Release signing — NEVER commit ──────────────────────────
# Keystore + Passwords. Loss = unable to update Play Store app.
# Backup separately in password manager + cloud (Drive verschlüsselt).
**/android/key.properties
**/android/upload-keystore.jks
**/android/app/upload-keystore.jks
**/*.jks
**/*.keystore
KEYSTORE_BACKUP.md

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
