# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── Release signing — NEVER commit ──────────────────────────
# Keystore + Passwords. Loss = unable to update Play Store app.
# Backup separately in password manager + cloud (Drive verschlüsselt).
**/android/key.properties
**/android/upload-keystore.jks
**/android/app/upload-keystore.jks
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
KEYSTORE_BACKUP.md

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

