# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── Release signing — NEVER commit ──────────────────────────
# Keystore + Passwords. Loss = unable to update Play Store app.
# Backup separately in password manager + cloud (Drive verschlüsselt).
**/android/key.properties
**/android/upload-keystore.jks
**/android/app/upload-keystore.jks
**/*.jks
**/*.keystore
KEYSTORE_BACKUP.md

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Auto-generated backups from 2026-05-29 PNG knockout (not for repo)
assets/illustrations/mascot/backup/
assets/illustrations/.bg_knockout_backup/
outputs_inspect/

# Build-pipeline caches (regenerable, may contain API responses)
scripts/cache/nikl/
scripts/cache/deepl_de.json
scripts/cache/wiktionary_de.json

# 투명 키잉 원본(흰배경) 백업 (2026-06-03)
.asset_keying_backup/

# Node.js dependencies (Cloud Functions) — npm install 로 재생성, 커밋 금지
**/node_modules/

# GCP/Firebase 서비스 계정 키 (시크릿 — 절대 커밋 금지)
