{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "ko-lernen-app",
          "appId": "1:573567222361:android:38d26a50001ee64c356748",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "ko-lernen-app",
          "configurations": {
            "android": "1:573567222361:android:38d26a50001ee64c356748"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions/gye",
      "codebase": "gye-firebase-functions",
      "runtime": "nodejs22"
    },
    {
      "source": "functions/tts",
      "codebase": "tts-firebase-functions",
      "runtime": "nodejs22"
    }
  ],
  "hosting": {
    "public": "docs",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/request-deletion-by-proof",
        "function": {
          "functionId": "requestDeletionByProof",
          "region": "europe-west3"
        }
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
