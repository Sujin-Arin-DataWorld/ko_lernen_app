          "displaySurfaceKo": "아니요, 그건 치즈예요.",
          "spokenSurfaceKo": "아니요, 그건 치즈예요.",
          "performanceCue": [
            "natural conversational delivery"
          ],
          "en": "No, that's cheese.",
          "de": "Nein, das ist Käse."
        },
        {
          "speaker": "user",
          "displaySurfaceKo": "그럼 이거예요?",
          "spokenSurfaceKo": "그럼 이거예요?",
          "performanceCue": [
            "natural conversational delivery"
          ],
          "en": "Then is it this one?",
          "de": "Dann ist es das hier?"
