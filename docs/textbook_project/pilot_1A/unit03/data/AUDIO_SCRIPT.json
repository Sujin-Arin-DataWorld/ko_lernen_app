          "displaySurfaceKo": "저쪽 냉장고 옆에 있어요.",
          "spokenSurfaceKo": "저쪽 냉장고 옆에 있어요.",
          "performanceCue": [
            "natural conversational delivery"
          ],
          "en": "Over there, next to the refrigerated section.",
          "de": "Dort drüben, neben dem Kühlregal."
        },
        {
          "speaker": "user",
          "displaySurfaceKo": "이거 두부예요?",
