# Deployment environment for the pronunciation codebase (firebase-functions dotenv).
# Cloud scoring is paused until subscription launch. Copy to .env (git-ignored)
# with the disabled mode for deployment. F0 configuration alone cannot bypass
# assessment_release_policy.js; re-enabling requires approved server entitlements.
# The existing secret stays bound but its value is never read while disabled.
PRONUNCIATION_ASSESSMENT_MODE=disabled
