# Variable-name reference only. Do not create a production `.env` from this
# file. Production secrets are attached from Secret Manager as documented in
# docs/store/cloud-function-deploy.md. Local tests must use mocks or ephemeral
# process environment values that are never committed.
DEEPL_API_KEY=
KRDIC_API_KEY=
# Comma-separated Firebase App IDs accepted by App Check verification.
# Both configured mobile apps must remain listed. Token verification still
# fails closed when App Check is not configured or the token is invalid.
ALLOWED_FIREBASE_APP_IDS=1:573567222361:android:38d26a50001ee64c356748,1:573567222361:ios:0f8c0734410bb6cc356748
