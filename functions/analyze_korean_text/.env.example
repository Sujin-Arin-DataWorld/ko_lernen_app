# Vorlage — echte Keys in `.env` eintragen (NICHT committen; .env ist gitignored).
# DeepL: https://www.deepl.com/pro-api  (Free-Key endet auf ":fx")
DEEPL_API_KEY=your-deepl-key-here
# 우리말샘 (NIKL Open Dictionary): https://opendict.korean.go.kr/service/openApiInfo
URIMALSAEM_API_KEY=your-urimalsaem-key-here
# Korean Basic Dictionary Open API. Used only by the protected word-chain
# fallback; never add this value to Flutter or commit the real .env file.
KRDIC_API_KEY=your-krdict-key-here
# Comma-separated Firebase App IDs accepted by App Check verification.
# Add the iOS Firebase App ID only after it has been created and App Check is configured.
ALLOWED_FIREBASE_APP_IDS=1:573567222361:android:38d26a50001ee64c356748
