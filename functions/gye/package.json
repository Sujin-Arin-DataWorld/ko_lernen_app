{
  "name": "gye-firebase-functions",
  "version": "1.0.0",
  "description": "계(契) Cloud Functions — Tier 3e",
  "main": "index.js",
  "scripts": {
    "test": "node --test lifecycle.test.js runtime.test.js account_operations.test.js account_operations_runtime.test.js",
    "test:rules": "firebase --config ../../firebase.json emulators:exec --project demo-hangul-sori --only firestore \"node --test firestore.rules.test.js\"",
    "serve": "firebase emulators:start --only functions",
    "deploy:indexes": "firebase --config ../../firebase.json deploy --only firestore:indexes",
    "deploy:rules": "firebase --config ../../firebase.json deploy --only firestore:rules",
    "deploy:functions": "firebase --config ../../firebase.json deploy --only functions:gye-firebase-functions",
    "smoke": "node smoke_test.js"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "engines": {
    "node": "22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.24.0"
  }
}
